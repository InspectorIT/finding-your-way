<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Finding Your Way" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Finding Your Way">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="navbar">
      <div>
        <strong><%= link_to "Finding Your Way", root_path, style: "margin-left: 0; font-size: 1.2em;" %></strong>
        <%= link_to "UI Kit", ui_kit_path %>
      </div>
      <div>
        <% if logged_in? %>
          <span>Привет, <%= current_user.name %>!</span>
          <%= link_to "Выйти", auth_logout_path, data: { turbo_method: :delete }, class: "btn btn-danger", style: "padding: 5px 10px; margin-left: 15px;" %>
        <% else %>
          <%= link_to "Войти", auth_login_path, class: "btn btn-secondary" %>
          <%= link_to "Регистрация", auth_register_path, class: "btn btn-primary", style: "color: white;" %>
        <% end %>
      </div>
    </nav>

    <!-- Контейнер для отступов контента -->
    <main style="padding: 30px; max-width: 1000px; margin: 0 auto;">
      <% flash.each do |type, msg| %>
        <div style="padding: 10px; margin-bottom: 20px; border-radius: 4px; <%= type == 'alert' ? 'background: #f8d7da; color: #721c24;' : 'background: #d4edda; color: #155724;' %>">
          <%= msg %>
        </div>
      <% end %>

      <!-- Здесь рендерится содержимое конкретных страниц -->
      <%= yield %>
    </main>
  </body>
</html>
