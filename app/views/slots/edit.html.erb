<h1>Редактирование свободного сеанса</h1>

<div class="card" style="max-width: 600px; margin: 0 auto;">
  <% if @slot.errors.any? %>
    <div class="card" style="margin-bottom: 20px;">
      <strong>Не удалось изменить сеанс:</strong>

      <ul>
        <% @slot.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @slot, url: slot_path(@slot), method: :patch do |form| %>
    <div class="form-group">
      <%= form.label :start_time, "Начало" %>
      <%= form.datetime_field :start_time,
                              required: true,
                              class: "form-control" %>
    </div>

    <div class="form-group">
      <%= form.label :end_time, "Окончание" %>
      <%= form.datetime_field :end_time,
                              required: true,
                              class: "form-control" %>
    </div>

    <%= hidden_field_tag :week, @week_offset %>

    <div style="display: flex; gap: 10px; margin-top: 20px;">
      <%= form.submit "Сохранить изменения", class: "btn btn-primary" %>

      <%= link_to "Отмена",
                  slots_path(week: @week_offset),
                  class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>
