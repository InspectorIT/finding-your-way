<div class="card" style="max-width: 500px; margin: 0 auto; margin-top: 50px;">
  <h1 style="text-align: center; margin-top: 0;">Вход в систему</h1>

  <%= form_with url: auth_login_path do |form| %>
    <div class="form-group">
      <%= form.label :email, "E-mail", class: "form-label" %>
      <%= form.email_field :email, class: "form-control" %>
    </div>

    <div class="form-group">
      <%= form.label :password, "Пароль", class: "form-label" %>
      <%= form.password_field :password, class: "form-control" %>
    </div>

    <div style="margin-top: 25px;">
      <%= form.submit "Войти", class: "btn btn-primary", style: "width: 100%;" %>
    </div>
  <% end %>
</div>