
<div
  class="psychologist-booking"
  data-controller="booking-dialog"
  data-booking-dialog-profile-id-value="<%= profile.id %>"
  data-booking-dialog-auto-open-value="<%= params[:calendar].to_s == profile.id.to_s %>"
>
  <button
    type="button"
    class="btn btn-primary psychologist-booking__toggle"
    data-action="booking-dialog#open"
  >
    Записаться
  </button>

  <dialog
    id="psychologist-<%= profile.id %>-calendar"
    class="psychologist-calendar-dialog"
    data-booking-dialog-target="dialog"
    data-action="click->booking-dialog#closeOnBackdrop close->booking-dialog#syncUrl"
    aria-labelledby="psychologist-<%= profile.id %>-calendar-title"
  >
    <div class="psychologist-calendar-dialog__panel">

      <!-- Заголовок модального окна -->
      <header class="psychologist-calendar-dialog__header">
        <div>
          <h2 id="psychologist-<%= profile.id %>-calendar-title">
            Запись к специалисту: <%= profile.user.name %>
          </h2>

          <p><%= profile.specialization %></p>

          <p>Выберите удобный день и свободное время.</p>
        </div>

        <button
          type="button"
          class="psychologist-calendar-dialog__close"
          data-action="booking-dialog#close"
          aria-label="Закрыть календарь"
        >
          <span aria-hidden="true">&times;</span>
          Закрыть
        </button>
      </header>

      <!-- Прокручиваемое содержимое -->
      <div class="psychologist-calendar-dialog__content">
        <div class="slot-calendar card">

          <!-- Панель переключения недель -->
          <div class="slot-calendar__toolbar">

            <div class="slot-calendar__toolbar-side">
              <% if @week_offset.positive? %>
                <%= link_to "‹",
                            psychologist_calendar_week_path(
                              profile,
                              @week_offset - 1,
                              home_page: home_page
                            ),
                            class: "btn btn-secondary slot-calendar__nav",
                            aria: { label: "Предыдущая неделя" } %>
              <% else %>
                <button
                  type="button"
                  class="btn btn-secondary slot-calendar__nav"
                  disabled
                  aria-label="Предыдущая неделя"
                >
                  ‹
                </button>
              <% end %>
            </div>

            <div class="slot-calendar__toolbar-center">
              <h3 class="slot-calendar__toolbar-title">
                <%= @calendar_days.first.strftime("%d.%m.%Y") %>
                —
                <%= @calendar_days.last.strftime("%d.%m.%Y") %>
              </h3>

              <p class="slot-calendar__toolbar-subtitle">
                <%= profile.session_duration %> минут ·
                <%= number_to_currency(
                      profile.price_per_session,
                      unit: "₽",
                      precision: 0,
                      format: "%n %u"
                    ) %> за сеанс
              </p>
            </div>

            <div class="slot-calendar__toolbar-side">
              <% if @week_offset < 52 %>
                <%= link_to "›",
                            psychologist_calendar_week_path(
                              profile,
                              @week_offset + 1,
                              home_page: home_page
                            ),
                            class: "btn btn-secondary slot-calendar__nav",
                            aria: { label: "Следующая неделя" } %>
              <% else %>
                <button
                  type="button"
                  class="btn btn-secondary slot-calendar__nav"
                  disabled
                  aria-label="Следующая неделя"
                >
                  ›
                </button>
              <% end %>
            </div>

          </div>

          <!-- Возврат к текущей неделе -->
          <% if @week_offset.positive? %>
            <div class="slot-calendar__current-week">
              <%= link_to "Текущая неделя",
                          psychologist_calendar_week_path(
                            profile,
                            0,
                            home_page: home_page
                          ),
                          class: "btn btn-secondary" %>
            </div>
          <% end %>

          <!-- Обозначения свободных и занятых слотов -->
          <div
            class="slot-calendar__legend"
            aria-label="Обозначения слотов"
          >
            <span class="slot-calendar__legend-item">
              <span class="slot-calendar__legend-dot slot-calendar__legend-dot--available"></span>
              Свободно
            </span>

            <span class="slot-calendar__legend-item">
              <span class="slot-calendar__legend-dot slot-calendar__legend-dot--booked"></span>
              Занято
            </span>
          </div>

          <!-- Сетка дней недели -->
          <div class="slot-calendar__days">
            <% @calendar_days.each do |day| %>
              <% day_slots =
                   @slots_by_profile_and_date.dig(profile.id, day) || [] %>

              <div class="slot-calendar__day">

                <div class="slot-calendar__day-head">
                  <span class="slot-calendar__day-name">
                    <%= %w[Вс Пн Вт Ср Чт Пт Сб][day.wday] %>
                  </span>

                  <span class="slot-calendar__day-date">
                    <%= day.strftime("%d.%m") %>
                  </span>
                </div>

                <div class="slot-calendar__slots">
                  <% if day_slots.empty? %>

                    <div class="slot-calendar__empty">
                      Нет слотов
                    </div>

                  <% else %>
                    <% day_slots.sort_by(&:start_time).each do |slot| %>

                      <% if slot.appointment.present? %>

                        <!-- Слот уже забронирован -->
                        <div class="slot-item slot-item--booked">
                          <span class="slot-item__time">
                            <%= slot.start_time.strftime("%H:%M") %>
                          </span>

                          <span class="slot-item__status">
                            занято
                          </span>
                        </div>

                      <% elsif logged_in? &&
                               current_user.client? &&
                               current_user.id != profile.user_id %>

                        <!-- Свободный слот: записываем клиента -->
                        <%= button_to appointments_path,
                                      method: :post,
                                      params: {
                                        slot_id: slot.id,
                                        return_to_home: home_page ? "1" : "0",
                                        week: @week_offset
                                      },
                                      class: "slot-item slot-item--available",
                                      form: {
                                        class: "slot-calendar__booking-form"
                                      } do %>
                          <span class="slot-item__time">
                            <%= slot.start_time.strftime("%H:%M") %>
                          </span>

                          <span class="slot-item__status">
                            Записаться
                          </span>
                        <% end %>

                      <% elsif !logged_in? %>

                        <!-- Для гостя предлагаем войти -->
                        <%= link_to auth_login_path,
                                    class: "slot-item slot-item--available" do %>
                          <span class="slot-item__time">
                            <%= slot.start_time.strftime("%H:%M") %>
                          </span>

                          <span class="slot-item__status">
                            Войти для записи
                          </span>
                        <% end %>

                      <% else %>

                        <!-- Сам специалист и другие роли не бронируют слот -->
                        <div class="slot-item slot-item--booked">
                          <span class="slot-item__time">
                            <%= slot.start_time.strftime("%H:%M") %>
                          </span>

                          <span class="slot-item__status">
                            Недоступно
                          </span>
                        </div>

                      <% end %>

                    <% end %>
                  <% end %>
                </div>

              </div>
            <% end %>
          </div>

        </div>
      </div>
    </div>
  </dialog>
</div>
