<%= form_with url: (
  comment.persisted? ?
    psychologist_comment_path(psychologist, comment) :
    psychologist_comments_path(psychologist)
),
              scope: :comment,
              method: (comment.persisted? ? :patch : :post),
              local: true,
              class: "comment-form" do |form| %>

  <div class="form-group">
    <%= form.label :body, "Ваш комментарий" %>

    <%= form.text_area :body,
                       rows: 4,
                       maxlength: 2000,
                       required: true,
                       placeholder: "Поделитесь своим мнением...",
                       class: "form-control" %>
  </div>

  <div class="form-group">
    <%= form.check_box :anonymous %>
    <%= form.label :anonymous, "Опубликовать анонимно" %>

    <small>
      Ваше имя будет скрыто от посетителей сайта.
      Комментарий останется связан с вашим аккаунтом.
    </small>
  </div>

  <%= form.submit(
        comment.persisted? ? "Сохранить изменения" : "Оставить комментарий",
        class: "btn btn-primary"
      ) %>
<% end %>
