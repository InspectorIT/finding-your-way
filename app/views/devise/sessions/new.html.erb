<div class="max-w-md mx-auto my-12 bg-white p-8 rounded-3xl border border-gray-200 shadow-sm">
  <h2 class="font-serif text-3xl text-brand-green mb-2">Вход в систему</h2>
  <p class="text-gray-500 text-sm mb-6">Введите ваши данные для входа в кабинет</p>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }) do |f| %>
    <div>
      <%= f.label :email, "Электронная почта", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "w-full px-4 py-2 border border-gray-300 rounded-xl focus:ring-2 focus:ring-brand-green focus:outline-none" %>
    </div>

    <div>
      <%= f.label :password, "Пароль", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.password_field :password, autocomplete: "current-password", class: "w-full px-4 py-2 border border-gray-300 rounded-xl focus:ring-2 focus:ring-brand-green focus:outline-none" %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="flex items-center gap-2">
        <%= f.check_box :remember_me, class: "rounded text-brand-green focus:ring-brand-green" %>
        <%= f.label :remember_me, "Запомнить меня", class: "text-sm text-gray-600" %>
      </div>
    <% end %>

    <div class="pt-4">
      <%= f.submit "Войти", class: "w-full bg-brand-green text-white py-3 rounded-xl font-medium hover:bg-opacity-90 transition cursor-pointer" %>
    </div>
  <% end %>

  <div class="mt-6 text-center text-sm text-gray-500">
    Ещё нет аккаунта? <%= link_to "Зарегистрироваться", new_registration_path(resource_name), class: "text-brand-green font-semibold hover:underline" %>
  </div>
</div>