<div class="max-w-md mx-auto my-12 bg-white p-8 rounded-3xl border border-gray-200 shadow-sm">
  <h2 class="font-serif text-3xl text-brand-green mb-2">Регистрация</h2>
  <p class="text-gray-500 text-sm mb-6">Создайте аккаунт, чтобы начать запись к специалистам</p>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <!-- Имя -->
    <div>
      <%= f.label :name, "ФИО или имя", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :name, autofocus: true, placeholder: "Анна Иванова", class: "w-full px-4 py-2 border border-gray-300 rounded-xl focus:ring-2 focus:ring-brand-green focus:outline-none" %>
    </div>

    <!-- Телефон -->
    <div>
      <%= f.label :phone, "Номер телефона", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.telephone_field :phone, placeholder: "+7 (999) 000-00-00", class: "w-full px-4 py-2 border border-gray-300 rounded-xl focus:ring-2 focus:ring-brand-green focus:outline-none" %>
    </div>

    <!-- Email -->
    <div>
      <%= f.label :email, "Электронная почта", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.email_field :email, autocomplete: "email", placeholder: "you@example.com", class: "w-full px-4 py-2 border border-gray-300 rounded-xl focus:ring-2 focus:ring-brand-green focus:outline-none" %>
    </div>

    <!-- Выбор роли -->
    <div>
      <%= f.label :role, "Я хочу зарегистрироваться как", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :role, [["Клиент", "client"], ["Психолог", "psychologist"]], {}, class: "w-full px-4 py-2 border border-gray-300 rounded-xl focus:ring-2 focus:ring-brand-green focus:outline-none" %>
    </div>

    <!-- Пароль -->
    <div>
      <%= f.label :password, "Пароль", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <% if @minimum_password_length %>
        <span class="text-xs text-gray-400">(минимум <%= @minimum_password_length %> символов)</span>
      <% end %>
      <%= f.password_field :password, autocomplete: "new-password", class: "w-full px-4 py-2 border border-gray-300 rounded-xl focus:ring-2 focus:ring-brand-green focus:outline-none" %>
    </div>

    <!-- Подтверждение пароля -->
    <div>
      <%= f.label :password_confirmation, "Подтверждение пароля", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full px-4 py-2 border border-gray-300 rounded-xl focus:ring-2 focus:ring-brand-green focus:outline-none" %>
    </div>

    <!-- Кнопка отправить -->
    <div class="pt-4">
      <%= f.submit "Зарегистрироваться", class: "w-full bg-brand-green text-white py-3 rounded-xl font-medium hover:bg-opacity-90 transition cursor-pointer" %>
    </div>
  <% end %>

  <div class="mt-6 text-center text-sm text-gray-500">
    Уже есть аккаунт? <%= link_to "Войти", new_session_path(resource_name), class: "text-brand-green font-semibold hover:underline" %>
  </div>
</div>