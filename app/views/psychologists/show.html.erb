<div class="psychologist-profile-page">
  <%= link_to "← К специалистам",
              root_path(anchor: "psychologists"),
              class: "btn btn-secondary" %>

  <section class="card psychologist-profile">
    <div class="psychologist-profile__image">
      <% if @psychologist.photo.attached? %>
        <%= image_tag @psychologist.photo,
                      alt: "Фотография: #{@psychologist.user.name}",
                      class: "psychologist-profile__photo" %>
      <% else %>
        <div class="psychologist-profile__photo-placeholder">
          <%= @psychologist.user.name.split.map { |part| part[0] }.first(2).join.upcase %>
        </div>
      <% end %>
    </div>

    <h1><%= @psychologist.user.name %></h1>

    <p class="psychologist-card__specialization">
      <%= @psychologist.specialization %>
    </p>

    <h2>О специалисте</h2>
    <%= simple_format(@psychologist.bio) %>

    <div class="psychologist-profile__facts">
      <p>
        <strong>Опыт работы:</strong>
        <%= @psychologist.experience_years %> лет
      </p>

      <p>
        <strong>Стоимость сеанса:</strong>
        <%= number_to_currency(
              @psychologist.price_per_session,
              unit: "₽",
              precision: 0,
              format: "%n %u"
            ) %>
      </p>

      <p>
        <strong>Длительность сеанса:</strong>
        <%= @psychologist.session_duration %> минут
      </p>
    </div>

    <%= render "psychologists/booking_dialog",
               profile: @psychologist,
               home_page: false %>
  </section>

  <section class="comments-section" id="comments">
    <h2>Комментарии</h2>

    <%= turbo_stream_from @psychologist, :comments %>

    <div class="comments-list" id="comments_list">
      <% if @comments.any? %>
        <%= render partial: "comments/comment",
                   collection: @comments,
                   as: :comment,
                   locals: { show_actions: true } %>
      <% else %>
        <%= render "comments/empty" %>
      <% end %>
    </div>

    <div class="comment-form-section">
      <% if @can_comment %>
        <h3>Оставить комментарий</h3>

        <%= render "comments/form",
                   psychologist: @psychologist,
                   comment: @new_comment %>

      <% elsif !logged_in? %>
        <p>
          <%= link_to "Войдите", auth_login_path %>,
          чтобы оставить комментарий.
        </p>

      <% elsif current_user.client? %>
        <p>
          Чтобы оставить комментарий, необходимо иметь запись к этому психологу.
        </p>

      <% else %>
        <p>Комментарии могут оставлять авторизованные клиенты.</p>
      <% end %>
    </div>
  </section>
</div>
