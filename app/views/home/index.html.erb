<% content_for :title, "Finding your way — техническая спецификация" %>

<div class="site-shell">
  <header class="topbar">
    <div class="topbar-inner">
      <button class="brand-lockup" type="button" data-scroll-to="top">
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="8"></circle>
            <path d="M15.5 8.5 13 13l-4.5 2.5L11 11l4.5-2.5Z"></path>
          </svg>
        </span>
        <span class="brand-name">Finding your way</span>
        <span class="brand-tag">этап 01 / техническая спецификация</span>
      </button>

      <nav class="nav-links" aria-label="Основная навигация">
        <button class="nav-link active" type="button" data-scroll-to="overview">Обзор</button>
        <button class="nav-link" type="button" data-scroll-to="features">Возможности</button>
        <button class="nav-link" type="button" data-scroll-to="submission">Сдача</button>
      </nav>

      <!-- НОВЫЙ БЛОК: Кнопки авторизации -->
      <div class="auth-actions">
        <% if defined?(Devise) && respond_to?(:user_signed_in?) && user_signed_in? %>
          <div class="user-dropdown">
            <button class="button-ghost profile-btn" type="button" onclick="document.getElementById('profile-menu').classList.toggle('show')">
              Профиль <span aria-hidden="true">▼</span>
            </button>
            <div id="profile-menu" class="dropdown-content">
              <%= link_to "Выйти из аккаунта", destroy_user_session_path, data: { turbo_method: :delete }, class: "dropdown-item" %>
            </div>
          </div>
        <% else %>
          <button class="button-ghost" type="button" onclick="document.getElementById('login-modal').showModal()">Войти</button>
          <button class="button-accent" type="button" onclick="document.getElementById('register-modal').showModal()">Зарегистрироваться</button>
        <% end %>
      </div>

      <button class="menu-button" type="button" aria-label="Открыть навигацию" aria-expanded="false" data-menu-toggle>
        <span></span><span></span><span></span>
      </button>
    </div>

    <nav class="mobile-menu" aria-label="Мобильная навигация" data-mobile-menu>
      <button class="nav-link active" type="button" data-scroll-to="overview">Обзор</button>
      <button class="nav-link" type="button" data-scroll-to="features">Возможности</button>
      <button class="nav-link" type="button" data-scroll-to="submission">Сдача</button>
    </nav>
  </header>

  <main>
    <section class="hero" id="top">
      <div class="reveal">
        <div class="eyebrow">Проект для важных первых шагов</div>

        <h1>Найти своего специалиста — значит начать с <em>доверия.</em></h1>

        <p class="hero-copy">
          Finding your way — спокойный сервис записи к психологам.
          Эта страница собирает техническую спецификацию первого этапа:
          роли, модели, маршруты и набор возможностей для будущего Rails-приложения.
        </p>

        <div class="hero-actions">
          <button class="button-primary" type="button" data-scroll-to="documentation">
            Открыть спецификацию <span aria-hidden="true">↓</span>
          </button>
          <button class="button-ghost" type="button" data-scroll-to="features">
            Посмотреть возможности <span aria-hidden="true">→</span>
          </button>
        </div>

        <div class="hero-note"><span></span>Готово к проверке преподавателем · Rails, этап 1</div>
      </div>

      <div class="hero-art" aria-label="Иллюстрация пути к записи на консультацию">
        <div class="hero-stamp">ЗАБОТА<br>НАЧИНАЕТСЯ<br>ЗДЕСЬ</div>
        <div class="orbit"></div>
        <div class="orbit two"></div>

        <div class="art-center" aria-hidden="true">
          <svg viewBox="0 0 48 48" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M24 37s-13-7.2-13-16.1C11 15.9 14.8 13 19 13c2.2 0 4.1 1.1 5 3 .9-1.9 2.8-3 5-3 4.2 0 8 2.9 8 7.9C37 29.8 24 37 24 37Z"></path>
            <path d="M17 24.5c2.2-2 4.4-2 6.6 0 2.2 2 4.4 2 6.6 0"></path>
          </svg>
        </div>

        <div class="art-pill pill-top"><span class="pill-icon">⌕</span>Найти своего специалиста</div>
        <div class="art-pill pill-mid"><span class="pill-icon">□</span>Выбрать время</div>
        <div class="art-pill pill-bottom"><span class="pill-icon">✓</span>Спокойное начало</div>
      </div>
    </section>

    <section class="section" id="overview">
      <div class="section-head">
        <div>
          <div class="section-kicker">01 / идея проекта</div>
          <h2 class="section-title">Более понятный путь к помощи.</h2>
        </div>
        <p class="section-intro">
          Поиск психолога не должен превращаться в ещё одну сложную задачу.
          Мы проектируем первый шаг так, чтобы он был ясным, бережным и предсказуемым.
        </p>
      </div>

      <div class="story-grid">
        <article class="story-card large">
          <div>
            <div class="quote-mark">“</div>
            <h3>Продукт — это не только запись. Это уверенность в том, что делать дальше.</h3>
          </div>
          <p>
            В центре проекта простой сценарий: найти специалиста, понять его профиль,
            выбрать свободное время и записаться на встречу без лишних сомнений.
          </p>
        </article>

        <article class="story-card">
          <div class="eyebrow">Кратко о проекте</div>
          <p>
            Finding your way — индивидуальный учебный проект на Ruby on Rails
            для поиска психологов и онлайн-записи на консультации.
            В этой спецификации зафиксированы предметная область и границы первого релиза.
          </p>

          <div class="principles">
            <div class="principle"><strong>Понятность</strong><span>Каждый следующий шаг виден заранее.</span></div>
            <div class="principle"><strong>Доверие</strong><span>Профиль и расписание помогают выбрать осознанно.</span></div>
            <div class="principle"><strong>Роли</strong><span>Клиент, психолог и администратор видят своё.</span></div>
            <div class="principle"><strong>Rails-ready</strong><span>Модели и маршруты готовы к реализации.</span></div>
          </div>
        </article>
      </div>
    </section>

    <section class="section-tint" id="features">
      <div class="section">
        <div class="section-head">
          <div>
            <div class="section-kicker">02 / возможности</div>
            <h2 class="section-title">Небольшой набор.<br>Всё по делу.</h2>
          </div>
          <p class="section-intro">
            Функциональность ограничена тем, что нужно для уверенного первого релиза:
            выбрать специалиста, открыть расписание и зафиксировать встречу.
          </p>
        </div>

        <div class="feature-grid">
          <% [
               ["01", "Регистрация и роли", "Авторизация с разделением доступа для клиента, психолога и администратора.", ["client", "psychologist", "admin"]],
               ["02", "Каталог специалистов", "Поиск психолога с фильтрами по стоимости консультации и опыту работы.", ["каталог", "фильтры"]],
               ["03", "Профиль и расписание", "Профиль специалиста показывает специализацию, опыт, стоимость и доступные слоты.", ["профиль", "слоты"]],
               ["04", "Запись на приём", "Клиент выбирает время и оставляет короткую анкету с причиной обращения.", ["booking", "анкета"]],
               ["05", "Личные кабинеты", "Клиент отменяет записи, а психолог создаёт и редактирует собственное расписание.", ["dashboard", "статусы"]]
             ].each do |number, title, description, tags| %>
            <article class="feature-card">
              <div class="feature-number"><%= number %></div>
              <div class="feature-icon"><%= number %></div>
              <h3><%= title %></h3>
              <p><%= description %></p>
              <div class="tag-row">
                <% tags.each do |tag| %>
                  <span class="tag"><%= tag %></span>
                <% end %>
              </div>
            </article>
          <% end %>
        </div>
      </div>
    </section>

    <section class="summary-band" id="submission">
      <div class="summary-inner">
        <div>
          <div class="section-kicker">03 / готово к сдаче</div>
          <h2 class="section-title">Хорошее начало<br>для большой работы.</h2>

          <p>
            В README находятся dbdiagram.io-схема базы данных,
            схема маршрутизации, список моделей с проверками и полный feature list.
          </p>

          <div class="hero-actions">
            <button class="copy-button copy-button-light" type="button" data-copy-target="submission-summary">
              Копировать резюме
            </button>

            <button class="button-ghost light-button" type="button" data-scroll-to="top">
              В начало <span aria-hidden="true">↗</span>
            </button>
          </div>

          <textarea id="submission-summary" class="visually-hidden">Finding your way — техническая спецификация, этап 1

Проект: сервис поиска психологов и записи на консультации
Возможности: роли, каталог, фильтры, профили, слоты, запись и кабинеты
Модели: User, PsychologistProfile, Slot, Appointment
Стек: Ruby on Rails, PostgreSQL, роли и model validations
Статус: готово к проверке преподавателем</textarea>
        </div>

        <div class="summary-list">
          <div class="summary-item"><span>Название проекта</span><span>Finding your way</span></div>
          <div class="summary-item"><span>Главный сценарий</span><span>найти → записаться</span></div>
          <div class="summary-item"><span>Документация</span><span>README + dbdiagram</span></div>
          <div class="summary-item"><span>Следующий этап</span><span>migrations + views</span></div>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <span>Finding your way · техническая спецификация / этап 01</span>
    <span>
      Сделано с заботой ·
      <button type="button" class="footer-link" data-scroll-to="top">
        вернуться в начало <span aria-hidden="true">↗</span>
      </button>
    </span>
  </footer>

  <!-- Модальное окно Входа -->
  <dialog id="login-modal" class="modal">
    <div class="modal-content">
      <button type="button" class="modal-close" onclick="document.getElementById('login-modal').close()">×</button>
      <h2>Вход в систему</h2>

      <%= form_with(scope: :user, url: session_path(:user), local: true) do |f| %>
        <div class="form-group">
          <%= f.label :email, "Email" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, class: "form-input" %>
        </div>

        <div class="form-group">
          <%= f.label :password, "Пароль" %>
          <%= f.password_field :password, autocomplete: "current-password", required: true, class: "form-input" %>
        </div>

        <div class="form-actions">
          <%= f.submit "Войти", class: "button-accent" %>
        </div>
      <% end %>
    </div>
  </dialog>

  <!-- Модальное окно Регистрации -->
  <dialog id="register-modal" class="modal">
    <div class="modal-content">
      <button class="close-btn" type="button" onclick="document.getElementById('register-modal').close()">×</button>
      <h3>Добро пожаловать</h3>
      <p>Создайте аккаунт, чтобы продолжить.</p>

      <!-- Здесь в будущем будет форма Devise -->
      <form action="#" class="auth-form">
        <input type="email" placeholder="Email" required class="form-input">
        <input type="password" placeholder="Пароль" required class="form-input">
        <input type="password" placeholder="Подтвердите пароль" required class="form-input">
        <button type="submit" class="button-accent w-full">Создать аккаунт</button>
      </form>
    </div>
  </dialog>
</div>