<h1>Моё расписание</h1>

<p>Добавляйте интервалы времени, в которые готовы проводить сеансы.</p>

<% if @slot.errors.any? %>
  <div class="card" style="margin-bottom: 20px;">
    <strong>Не удалось добавить сеанс:</strong>
    <ul>
      <% @slot.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="card" style="margin-bottom: 25px;">
  <h2>Добавить свободный сеанс</h2>

  <%= form_with model: @slot, url: slots_path do |form| %>
    <div class="form-group">
      <%= form.label :start_time, "Начало" %>
      <%= form.datetime_field :start_time,
                              required: true,
                              class: "form-control" %>
    </div>

    <div class="form-group">
      <%= form.label :end_time, "Окончание" %>
      <%= form.datetime_field :end_time,
                              required: true,
                              class: "form-control" %>
    </div>

    <%= form.submit "Добавить сеанс", class: "btn btn-primary" %>
  <% end %>
</div>

<h2>Запланированные интервалы</h2>

<% if @slots.any? %>
  <ul>
    <% @slots.each do |slot| %>
      <li>
        <%= slot.start_time.strftime("%d.%m.%Y %H:%M") %>
        —
        <%= slot.end_time.strftime("%H:%M") %>

        <% if slot.appointment.present? %>
          <strong>Занят</strong>
        <% else %>
          <strong>Свободен</strong>
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>Расписание пока пустое.</p>
<% end %>
